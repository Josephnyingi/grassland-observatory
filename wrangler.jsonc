{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grassland-observatory",
  "main": "src/index.js",
  "compatibility_date": "2026-08-18",
  "observability": {
    "enabled": true,
  },
  "containers": [
    {
      "class_name": "RangelandObservatoryContainer",
      "image": "./Dockerfile",
      "max_instances": 3,
      "name": "grassland-observatory-dashboard",
      "instance_type": "standard-1",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "RangelandObservatoryContainer",
        "name": "DASHBOARD_CONTAINER",
      },
    ],
  },
  "migrations": [
    {
      "new_sqlite_classes": ["RangelandObservatoryContainer"],
      "tag": "v1",
    },
  ],
}
